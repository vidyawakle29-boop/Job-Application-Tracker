# ==========================================
# Server Environment Configuration
# ==========================================

# Port the Express server will listen on
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017/job_tracker_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/job_tracker_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/job_tracker_db

# JWT Secret Key for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_internship_project_2026_change_in_production

# JWT Expiration Time (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Client URL for CORS whitelist
CLIENT_URL=http://localhost:5173
