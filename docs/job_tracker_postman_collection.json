{
  "info": {
    "name": "Job Application Tracker API Collection",
    "description": "Complete Postman collection for the Job Application Tracker REST APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "authToken", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health" }
      }
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/register" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Internship Candidate\",\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\",\n  \"targetRole\": \"Full Stack Engineer\",\n  \"location\": \"Remote\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/login" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/me" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    },
    {
      "name": "3. Job Applications",
      "item": [
        {
          "name": "Create Application",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/applications" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Stripe\",\n  \"jobTitle\": \"Software Engineer Intern\",\n  \"jobLocation\": \"Remote\",\n  \"jobType\": \"Internship\",\n  \"salary\": \"$55/hr\",\n  \"status\": \"Applied\",\n  \"jobPostingUrl\": \"https://stripe.com/jobs\",\n  \"notes\": \"Referred by alumnus\"\n}"
            }
          }
        },
        {
          "name": "Get All Applications",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/applications?status=All&sortBy=applicationDate&sortOrder=desc" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Get Single Application",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/applications/{{applicationId}}" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/applications/{{applicationId}}/status" },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Interview Scheduled\",\n  \"comment\": \"Passed coding assessment. Onsite round next week.\"\n}"
            }
          }
        },
        {
          "name": "Delete Application",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/applications/{{applicationId}}" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    },
    {
      "name": "4. Dashboard & Analytics",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/stats/dashboard" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    },
    {
      "name": "5. Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/notifications" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/notifications/read-all" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    },
    {
      "name": "6. Web Scraper",
      "item": [
        {
          "name": "Search Scraped Jobs",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/scraper/jobs?query=Engineer&location=Remote" },
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
          }
        }
      ]
    }
  ]
}
