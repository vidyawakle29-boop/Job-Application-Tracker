# ----------------------------------------
# Root .gitignore for Job Application Tracker
# ----------------------------------------

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables (Crucial for security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
ENV/
.venv/

# Build artifacts
dist/
build/
out/

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
